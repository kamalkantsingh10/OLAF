<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>expression_engine</name>
  <version>0.1.0</version>
  <description>OLAF expression engine — subscribes to the companion pipeline's 4 canonical topics (mood/activity/speech_emotion/vocalization) and renders expression on servos/LEDs/eyes/heart. See docs/sprint-change-proposal-2026-05-15.md.</description>
  <maintainer email="kamalkantsingh10@gmail.com">Kamal Kant Singh</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>olaf_interfaces</exec_depend>
  <exec_depend>neck_driver</exec_depend>
  <exec_depend>head_ears_driver</exec_depend>

  <!-- Wire-schema validation (Story 6.1, AR13). pydantic v2 is REQUIRED
       (companion contract @ v3.0.0 uses ConfigDict / model_validator).
       The rosdep key `python3-pydantic` is deliberately NOT declared:
       on Ubuntu 24.04 it resolves to apt python3-pydantic v1.10, which
       is incompatible. pydantic>=2 is provided via the project poetry
       environment (pyproject.toml / setup.py install_requires), the
       same runtime OLAF already uses on the Pi (`~/.local/bin/poetry
       run`). Revisit as deployment hardening in Story 6.7. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
