# Ignore Claude configuration folder
.claude/

# Ignore bmad-core folder
.bmad-core/

# Ignore content drafts (LinkedIn posts, videos, etc.)
.content/

# Archive folder for old project files (ad-hoc scratch — ignored).
# archive/ros2/ ALSO holds a pre-existing prior workspace (build/install/log/src)
# which must stay ignored. So we ignore contents level-by-level and re-include
# ONLY the three subtrees the Phase 2 re-scope intentionally archived.
# See docs/sprint-change-proposal-2026-05-15.md.
archive/*
!archive/ros2/
archive/ros2/*
!archive/ros2/olaf_interfaces/
!archive/ros2/olaf_drivers/
!archive/ros2/olaf_bringup/

# Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
venv/
env/
ENV/
*.egg
*.egg-info/
dist/
/build/                 # Ignore build/ at root only (ROS2 builds go in ros2/build/)

# Poetry
poetry.lock
.venv/
*.poetry/

# ROS2
ros2/build/
ros2/install/
ros2/log/
*.bag

# PlatformIO
.pio/
.vscode/
*.bin

# Environment and secrets
.env
*.key
*.pem

# MCP (Model Context Protocol)
.mcp.json
logs/

# IDE
.idea/
*.swp
*.swo
*~

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Pytest coverage data
.coverage

